{
  "name": "dollim-calendar",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @dollim/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "openapi": "pnpm --filter @dollim/contracts openapi",
    "api:gen": "pnpm openapi && pnpm --filter @dollim/web orval",
    "db:generate": "pnpm --filter @dollim/db generate",
    "db:migrate": "pnpm --filter @dollim/db migrate",
    "db:studio": "pnpm --filter @dollim/db studio",
    "db:seed": "pnpm --filter @dollim/db seed",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.3"
  }
}
